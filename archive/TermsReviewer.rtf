\f3\b0\fs26 \cf0 create type doc_type as enum ('tos','privacy','cookies','dpa','eula','ai_policy');\
create type severity as enum ('high','medium','low');\
\
create table vendor (\
  id uuid primary key,\
  name text not null,\
  domain text not null unique,\
  category text,\
  risk_score_current numeric,\
  created_at timestamptz default now()\
);\
\
create table document (\
  id uuid primary key,\
  vendor_id uuid references vendor(id),\
  type doc_type not null,\
  source_url text,\
  lang_detected text,\
  checksum text\
);\
\
create table document_version (\
  id uuid primary key,\
  document_id uuid references document(id),\
  version_tag text,\
  fetched_at timestamptz,\
  storage_uri text,\
  content_hash text,\
  original_lang text,\
  mt_applied boolean default false\
);\
