#!/usr/bin/env bash
# Governance-tier pre-commit hook.
#
# Enforces these invariants:
#   1. .gitignore contains every required pattern from
#      .claude/governance/required-gitignore.txt (single source of truth,
#      reviewer P9 grumpy F9).
#   2./3. Replaced by check 5 (#236): graveyard and .env checks now run in the
#      shared tree guard, at any depth and with .env look-alikes folded.
#   4. No staged file under docs/evidence/ contains a local machine path
#      or private directory name (pytest/macOS/Claude temp dirs, home
#      directories, home-relative private folders, agent worktree IDs; pattern SSoT .claude/governance/evidence-leak-regex.txt,
#      matcher scripts/governance/leak_scan.py, shared with CI)
#      (issue #91 P9 security F1, round 2 R2-F3, round 5 normalising matcher;
#      round 8: staged path names, type changes and opaque containers too).
#   5. Tree guard (#145 / #236), scripts/governance/tree_guard.py, shared with
#      .github/workflows/gitignore-enforcement.yml. Over every entry of the
#      index being committed: no home path in a blob, symlink target or path
#      name (patterns .claude/governance/personal-path-patterns.txt), no file
#      under a graveyard directory at any depth (directory entries of the
#      required-gitignore SSoT), no .env look-alike. Success prints the exact
#      line "CLEAN <n>".
#
# Import mode (#384, owner ruling 2026-10-15, design Option A): exactly one
# commit skips check 1, the #125 relocation commit of the ingester tree.
# scripts/governance/import_guard.py decides, from the HOOK checkout's own
# .claude/governance/monorepo-layout.conf (HOOK_ROOT is derived from this
# file's location, never from the committing worktree). In import mode checks
# 4 and 5 still run, with the hook checkout's scripts and governance files.
# A missing conf grants nothing; a failed proof refuses hard.
#
# Install with: scripts/install-hooks.sh
# Governance policy: to change the required list, edit
# .claude/governance/required-gitignore.txt (both this hook and
# .github/workflows/gitignore-enforcement.yml read from it).

set -euo pipefail
# An exported CDPATH makes `cd <relative>` search elsewhere and echo the result.
unset CDPATH

# The checkout this hook file lives in (core.hooksPath is absolute and points
# at the main checkout's .githooks, #384 ruling 3). From BASH_SOURCE with
# `cd -P`, not `git rev-parse`: during a commit GIT_DIR, GIT_WORK_TREE and
# GIT_INDEX_FILE describe the COMMITTING worktree. Resolved before any cd.
HOOK_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"

REPO_ROOT="$(git rev-parse --show-toplevel)"
# F8: every path below is repo-relative, so no message prints an absolute path.
# Import mode reads assets under HOOK_ROOT; its messages use the relative names.
cd "${REPO_ROOT}"
GITIGNORE=".gitignore"
REQUIRED_LIST_FILE=".claude/governance/required-gitignore.txt"
# One interpreter setting for every Python check in this hook.
GUARD_PYTHON="${LEAK_SCAN_PYTHON:-python3}"

fail() {
    printf 'pre-commit: %s\n' "$1" >&2
    exit 1
}

# --- Import mode (#384) -------------------------------------------------------
# Whenever the hook checkout has the conf, the helper runs for every commit,
# so a broken helper is noticed on ordinary commits too. Fail closed: only rc 0 with the exact last line "NOT-IMPORT" or
# "IMPORT <tip> <tree>" is a verdict. It runs in a subshell whose stderr is
# discarded first, so a helper killed by a signal cannot make bash print the
# job-status line (which names this hook's absolute path, F8).
IMPORT_HELPER_REL="scripts/governance/import_guard.py"
IMPORT_CONF_REL=".claude/governance/monorepo-layout.conf"
if [[ ! -e "${HOOK_ROOT}/${IMPORT_CONF_REL}" && ! -L "${HOOK_ROOT}/${IMPORT_CONF_REL}" ]]; then
    # No conf in the hook checkout: no exemption can exist, so the normal path
    # runs unchanged (the helper would answer NOT-IMPORT for the same reason).
    import_out="NOT-IMPORT"
    import_rc=0
else
    # A conf exists, so the helper must run: missing helper or interpreter
    # refuses (fail closed), never skips the proof.
    [[ -f "${HOOK_ROOT}/${IMPORT_HELPER_REL}" ]] \
        || fail "import check helper missing in the hook checkout: ${IMPORT_HELPER_REL}"
    command -v "${GUARD_PYTHON}" >/dev/null 2>&1 \
        || fail "${GUARD_PYTHON} not found (needed by ${IMPORT_HELPER_REL})"
    # stderr of the whole substitution goes to /dev/null so a signalled helper
    # cannot print bash's job-status line (which names the hook's path).
    set +e
    import_out="$(exec 2>/dev/null; ("${GUARD_PYTHON}" -I "${HOOK_ROOT}/${IMPORT_HELPER_REL}" "${HOOK_ROOT}/${IMPORT_CONF_REL}"))"
    import_rc=$?
    set -e
fi
import_last="${import_out##*$'\n'}"
IMPORT_MODE=0
if [[ "${import_rc}" -eq 0 ]] && [[ "${import_last}" == "NOT-IMPORT" ]]; then
    :
elif [[ "${import_rc}" -eq 0 ]] && [[ "${import_last}" =~ ^IMPORT\ ([0-9a-f]{40})\ ([0-9a-f]{40})$ ]]; then
    import_tip="${BASH_REMATCH[1]}"
    import_tree="${BASH_REMATCH[2]}"
    # Defence in depth: the verdict must name this HEAD and this index's tree.
    [[ "$(git rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null || true)" == "${import_tip}" ]] \
        || fail "import check verdict does not match HEAD; commit refused"
    [[ "$(git write-tree 2>/dev/null || true)" == "${import_tree}" ]] \
        || fail "import check verdict does not match the tree being committed; commit refused"
    IMPORT_MODE=1
    printf 'pre-commit: import mode: HEAD is the pinned ingester tip and the index holds exactly its tree under the pinned prefix; check 1 skipped, checks 4 and 5 run with the hook checkout files\n' >&2
    printf 'pre-commit: IMPORT %s %s\n' "${import_tip}" "${import_tree}" >&2
elif [[ "${import_rc}" -eq 1 ]] && [[ "${import_last}" == "IMPORT-REFUSED" ]]; then
    # The helper's own reason lines: fixed text, no paths, no conf values
    # beyond max_message_chars. Printable ASCII only, defensively.
    while IFS= read -r import_line; do
        [[ "${import_line}" == "IMPORT-REFUSED" ]] && continue
        printf 'pre-commit: %s\n' "${import_line}" | LC_ALL=C tr -cd '\11\12\40-\176' >&2
    done <<< "${import_out}"
    fail "commit refused by the import check (${IMPORT_HELPER_REL}); see the reason above."
else
    fail "import check failed (exit ${import_rc}, no verdict); commit refused."
fi

# Asset paths: repo-relative on the normal path (unchanged), the hook
# checkout's in import mode. Messages always print the relative names.
ASSET_ROOT=""
[[ "${IMPORT_MODE}" -eq 1 ]] && ASSET_ROOT="${HOOK_ROOT}/"

if [[ "${IMPORT_MODE}" -eq 0 ]]; then
# Load required patterns from SSoT (skip comments + blank lines).
if [[ ! -f "${REQUIRED_LIST_FILE}" ]]; then
    printf 'pre-commit: required-gitignore SSoT missing: %s\n' "${REQUIRED_LIST_FILE}" >&2
    exit 1
fi
REQUIRED_GITIGNORE_PATTERNS=()
while IFS= read -r line; do
    # Strip leading/trailing whitespace, skip comments and empties.
    trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ -z "${trimmed}" ]] && continue
    [[ "${trimmed:0:1}" == "#" ]] && continue
    REQUIRED_GITIGNORE_PATTERNS+=("${trimmed}")
done < "${REQUIRED_LIST_FILE}"

# --- Check 1: required .gitignore entries -----------------------------------
if [[ ! -f "${GITIGNORE}" ]]; then
    fail ".gitignore is missing from repo root. This file is required."
fi

for pattern in "${REQUIRED_GITIGNORE_PATTERNS[@]}"; do
    # Exact-line match against .gitignore. Comments and inline whitespace on the
    # pattern line are not accepted -- must be a clean line-for-line match.
    # "--": a required pattern starting with "-" is a pattern, not an option.
    if ! grep -Fxq -- "${pattern}" "${GITIGNORE}"; then
        fail ".gitignore is missing required pattern: \`${pattern}\`. This entry is protected -- see .claude/governance/required-gitignore.txt."
    fi
done
fi  # end of the normal path's check 1; import mode skips it (#384)

# --- Check 4: no local machine paths in staged evidence files --------------
# Issue #91 P9 security F1: captured test output committed under
# docs/evidence/ leaked the local account name, the macOS per-user temp-folder
# ID and the private directory layout into a PUBLIC repo. Scan the STAGED
# blob (git show ":path", not the working-tree copy, so a scrubbed-but-
# unstaged file can't mask a dirty staged one). Scrub with placeholders such
# as <tmp>/, <repo>/ or <user>.
# Round 2 (security R2-F3 / grumpy #6):
#   * filenames are read NUL-delimited (-z), so a non-ASCII name is no longer
#     C-quoted by core.quotePath and silently skipped;
#   * NUL bytes are stripped and grep -a is used, so UTF-16 text and binary
#     blobs are scanned instead of skipped by grep -I;
#   * the pattern is shared with CI (scripts/governance/scan-evidence-leaks.sh)
#     via .claude/governance/evidence-leak-regex.txt and also covers
#     /var/folders/ without /private and Linux /home/<name>.
# Round 3 (security R3-F1/R3-F2, grumpy #1): the SSoT also blocks the dashed
# scratchpad account-name form, the per-uid Claude temp root, home-relative
# private folders and agent worktree IDs, and only matches real path segments.
# Round 5 (grumpy, whack-a-mole rule): matching moved to ONE Python matcher,
# scripts/governance/leak_scan.py, also used by scan-evidence-leaks.sh. It
# URL-decodes, unescapes (\/ \\ \u002f) and case-folds each line before the
# canonical patterns run, so encoded spellings need no extra alternatives.
# Vectors: .claude/governance/leak-vectors.tsv.
EVIDENCE_PREFIX="docs/evidence/"
EVIDENCE_REGEX_FILE=".claude/governance/evidence-leak-regex.txt"
EVIDENCE_MATCHER="scripts/governance/leak_scan.py"
EVIDENCE_PYTHON="${GUARD_PYTHON}"
EVIDENCE_STAGED_Z="$(mktemp)"
EVIDENCE_BLOB="$(mktemp)"
EVIDENCE_HITS="$(mktemp)"
EVIDENCE_NAMES="$(mktemp)"
GUARD_OUT="$(mktemp)"
trap 'rm -f "${EVIDENCE_STAGED_Z}" "${EVIDENCE_BLOB}" "${EVIDENCE_HITS}" "${EVIDENCE_NAMES}" "${GUARD_OUT}"' EXIT
# #91 r8 (grumpy 5 / security F5): T (type change, e.g. a file replaced by a
# symlink) is scanned too; git show ":path" yields a symlink's target path.
git diff --cached --name-only -z --diff-filter=ACMRT > "${EVIDENCE_STAGED_Z}" \
    || fail "could not list staged files for the evidence path scan"
if [[ -s "${EVIDENCE_STAGED_Z}" ]]; then
    [[ -f "${ASSET_ROOT}${EVIDENCE_REGEX_FILE}" ]] \
        || fail "evidence leak pattern SSoT missing: ${EVIDENCE_REGEX_FILE}"
    [[ -f "${ASSET_ROOT}${EVIDENCE_MATCHER}" ]] \
        || fail "evidence leak matcher missing: ${EVIDENCE_MATCHER}"
    command -v "${EVIDENCE_PYTHON}" >/dev/null 2>&1 \
        || fail "${EVIDENCE_PYTHON} not found (needed by ${EVIDENCE_MATCHER})"
    while IFS= read -r -d '' path; do
        [[ -z "${path}" ]] && continue
        [[ "${path}" == "${EVIDENCE_PREFIX}"* ]] || continue
        # Fail closed: an unreadable staged blob or a matcher error (exit 2) is a
        # hook failure, never a silent pass. C locale = byte-wise matching
        # (macOS tr/grep otherwise reject non-UTF-8 bytes).
        git show ":${path}" | LC_ALL=C tr -d '\000' > "${EVIDENCE_BLOB}" \
            || fail "could not read staged blob for ${path}"
        set +e
        # grep-compatible: "<line>:<pattern>" lines, exit 0 hit / 1 none /
        # 2 error (bad SSoT, unreadable input). -I = isolated interpreter.
        "${EVIDENCE_PYTHON}" -I "${ASSET_ROOT}${EVIDENCE_MATCHER}" "${ASSET_ROOT}${EVIDENCE_REGEX_FILE}" "${EVIDENCE_BLOB}" > "${EVIDENCE_HITS}"
        grep_rc=$?
        set -e
        if [[ "${grep_rc}" -eq 0 ]]; then
            lines="$(cut -d: -f1 "${EVIDENCE_HITS}" | head -5 | paste -sd, -)"
            pats="$(cut -d: -f2 "${EVIDENCE_HITS}" | sort -u | paste -sd, -)"
            fail "Refusing to stage ${path}: contains a local machine path or private directory name (pattern(s) ${pats}, SSoT .claude/governance/evidence-leak-regex.txt) at line(s) ${lines}. Scrub to <tmp>/, <repo>/ or <user> before committing."
        elif [[ "${grep_rc}" -ne 1 ]] || ! grep -Eqx 'CLEAN [0-9]+' "${EVIDENCE_HITS}"; then
            # #91 security r6: fail closed. Exit 1 is "no leak" only with the
            # matcher's "CLEAN <n>" sentinel; a crash before main() also
            # exits 1 but prints none. Any other exit code is an error.
            fail "evidence path scan failed for ${path} (matcher exit ${grep_rc}, no clean attestation)"
        fi
        printf '%s\n' "${path}" >> "${EVIDENCE_NAMES}"
    done < "${EVIDENCE_STAGED_Z}"
    # #91 r8 (security F4): the staged PATH NAMES are scanned as well, so a
    # file or directory named after a home slug cannot slip in with clean
    # content. Same matcher, same fail-closed sentinel rule.
    if [[ -s "${EVIDENCE_NAMES}" ]]; then
        set +e
        "${EVIDENCE_PYTHON}" -I "${ASSET_ROOT}${EVIDENCE_MATCHER}" "${ASSET_ROOT}${EVIDENCE_REGEX_FILE}" "${EVIDENCE_NAMES}" > "${EVIDENCE_HITS}"
        grep_rc=$?
        set -e
        if [[ "${grep_rc}" -eq 0 ]]; then
            bad="$(cut -d: -f1 "${EVIDENCE_HITS}" | head -5 | while IFS= read -r n; do sed -n "${n}p" "${EVIDENCE_NAMES}"; done | paste -sd, -)"
            pats="$(cut -d: -f2 "${EVIDENCE_HITS}" | sort -u | paste -sd, -)"
            fail "Refusing to stage path name(s) ${bad}: the name contains a local machine path or private directory name (pattern(s) ${pats}, SSoT .claude/governance/evidence-leak-regex.txt). Rename before committing."
        elif [[ "${grep_rc}" -ne 1 ]] || ! grep -Eqx 'CLEAN [0-9]+' "${EVIDENCE_HITS}"; then
            fail "evidence path name scan failed (matcher exit ${grep_rc}, no clean attestation)"
        fi
    fi
fi

# --- Check 5: tree guard (home paths, graveyard at any depth, .env) ---------
# #145 / #236. Runs after check 4 so an evidence leak keeps its own message.
# Scans the whole index being committed (a temporary index under
# `git commit <paths>` included), not the working tree (F7). Fail closed: exit
# 0 counts only with the exact "CLEAN <n>" line and exit 1 only with the
# "REFUSED <n>" line; anything else (crash, config error) is a failure too.
GUARD_SCRIPT="scripts/governance/tree_guard.py"
GUARD_PATTERNS=".claude/governance/personal-path-patterns.txt"
[[ -f "${ASSET_ROOT}${GUARD_SCRIPT}" ]] || fail "tree guard missing: ${GUARD_SCRIPT}"
command -v "${GUARD_PYTHON}" >/dev/null 2>&1 \
    || fail "${GUARD_PYTHON} not found (needed by ${GUARD_SCRIPT})"
set +e
"${GUARD_PYTHON}" -I "${ASSET_ROOT}${GUARD_SCRIPT}" "${ASSET_ROOT}${GUARD_PATTERNS}" "${ASSET_ROOT}${REQUIRED_LIST_FILE}" > "${GUARD_OUT}" 2>&1
guard_rc=$?
set -e
guard_last="$(tail -n 1 "${GUARD_OUT}")"
if [[ "${guard_rc}" -eq 0 ]] && [[ "${guard_last}" =~ ^CLEAN\ [0-9]+$ ]]; then
    printf '%s\n' "${guard_last}" >&2
    exit 0
fi
# The guard prints names escaped and never echoes file content (F2/F8). In
# import mode its config messages name the absolute hook-checkout asset path;
# that prefix is replaced so no absolute path is printed (F8).
while IFS= read -r guard_line || [[ -n "${guard_line}" ]]; do
    [[ -n "${ASSET_ROOT}" ]] && guard_line="${guard_line//"${ASSET_ROOT}"/<hook checkout>/}"
    printf 'pre-commit: %s\n' "${guard_line}" >&2
done < "${GUARD_OUT}"
if [[ "${guard_rc}" -eq 1 ]] && [[ "${guard_last}" =~ ^REFUSED\ [0-9]+$ ]]; then
    # No file names or reason tags here: each listed line carries its own.
    fail "commit refused by ${GUARD_SCRIPT}; fix the path(s) listed above."
fi
fail "tree guard failed (exit ${guard_rc}, no clean attestation)"
