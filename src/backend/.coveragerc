# Coverage config for the backend test suite (read from src/backend, the
# directory CI runs pytest in).
# precision = 2 keeps local totals at two decimals, matching the
# --cov-precision=2 flag in .github/workflows/ci.yml. Without it, a total such
# as 97.58% rounds to 98 and would pass a 98 floor (#177).
# The 98 floor is deliberately NOT set here (no fail_under): it is pinned by
# --cov-fail-under=98 in .github/workflows/ci.yml, so partial local --cov runs
# (e.g. /test-suite on a single file) do not fail on total coverage.
[report]
precision = 2
