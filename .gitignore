# Temporary files
tmp/
temp/
*.tmp

# Local data — runtime DB and generated legal-KB index/metadata are ignored,
# but the legal_corpus/ source text is checked in like any other source asset.
data/*
!data/legal_corpus/
!data/legal_corpus/**
*.db

# Archive backups (already in archive/ but ignore if generated)
*.bak
*.backup
*~

# OS generated files
ehthumbs.db
Desktop.ini

# Personal notes (if any)
notes.txt
TODO.txt
.scratch/

# Invariant-protected patterns (enforced by .githooks/pre-commit and
# .github/workflows/gitignore-enforcement.yml — do not remove without a
# governance-tier PR that also updates the enforcement lists).
ignore/
.pip-cache/
*.db-journal

# Agent-sweep backups (Doer/Critic diff record for .claude/ rewrites; not committed)
.claude/_pre-agent-sweep-backup/

# Playwright MCP scratch snapshots (timestamped page/console/snap dumps)
.playwright-mcp/

# Session handoffs — local only per user directive 2026-07-03
SESSION_HANDOFF_*.md
