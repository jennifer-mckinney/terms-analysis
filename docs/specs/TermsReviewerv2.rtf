  id UUID PRIMARY KEY, document_id UUID REFERENCES documents(id),\
  version_tag TEXT, snapshot_s3_uri TEXT NOT NULL, checksum TEXT NOT NULL,\
  fetched_at TIMESTAMPTZ, page_count INT, text_bytes BIGINT\
);\
\
-- Findings and citations\
CREATE TYPE jurisdiction AS ENUM ('us','eu','uk','ca');\
CREATE TABLE findings (\
  id UUID PRIMARY KEY, version_id UUID REFERENCES document_versions(id),\
  category TEXT, -- e.g., arbitration, class_action_waiver, retention, residency, processors\
  severity SMALLINT CHECK (severity BETWEEN 0 AND 4),\
  score NUMERIC(4,3),\
  jurisdictions jurisdiction[] DEFAULT ARRAY[]::jurisdiction[],\
  title TEXT, description TEXT,\
  excerpt TEXT, start_offset INT, end_offset INT, page INT, section_anchor TEXT,\
  rule_ids TEXT[], model_ids TEXT[], created_at TIMESTAMPTZ DEFAULT now()\
);\
CREATE TABLE citations (\
  id UUID PRIMARY KEY, finding_id UUID REFERENCES findings(id),\
  version_id UUID REFERENCES document_versions(id), excerpt TEXT,\
  context_before TEXT, context_after TEXT, page INT, locator JSONB\
);\
\
-- Rubric scoring\
CREATE TABLE rubric_scores (\
  id UUID PRIMARY KEY, version_id UUID REFERENCES document_versions(id),\
  category TEXT, weight NUMERIC(4,3), score_raw NUMERIC(2,1), score_weighted NUMERIC(4,3),\
  evaluator TEXT DEFAULT 'system', created_at TIMESTAMPTZ DEFAULT now()\
);\
\
-- Watchlists and alerts\
CREATE TABLE watchlists (\
  id UUID PRIMARY KEY, user_id UUID, vendor_id UUID REFERENCES vendors(id),\
  channels TEXT[] -- e.g., ['email:security@acme.com','slack:#vendor-risk']\
);\
CREATE TABLE alerts (\
  id UUID PRIMARY KEY, watchlist_id UUID REFERENCES watchlists(id),\
  change_type TEXT, severity SMALLINT, summary TEXT, diff_s3_uri TEXT,\
  delivered_via TEXT, delivered_at TIMESTAMPTZ\
);\
