# LocalAI inference backend (Apache 2.0, zero VC — https://localai.io)
# Start LocalAI: docker run -p 8080:8080 localai/localai:latest
LOCALAI_BASE_URL=http://localhost:8080/v1

# Models (load in LocalAI before starting the backend)
# Apertus 8B Instruct — Swiss AI Initiative (EPFL/ETH Zurich/CSCS), Apache 2.0
# https://huggingface.co/swiss-ai/Apertus-8B-Instruct-2509-GGUF
MODEL_WORLD=apertus-8b-instruct

# EuroLLM 22B Instruct — EU Horizon Europe / EuroHPC, Apache 2.0, 35 EU languages
# https://huggingface.co/utter-project/EuroLLM-22B-Instruct-GGUF
MODEL_EU=eurollm-22b-instruct

# Database
DATABASE_URL=sqlite:///./data/terms_analysis.db

# API security (leave empty to disable auth for local dev)
# API_KEY=

# Analysis settings
REVIEW_THRESHOLD=0.80
# Text-paste cap (chars). Applies to the /analyze text body; /infer has its
# own separate cap. Raised from 20000 → 50000 per PRD §5 open question
# resolution (aligns UI paste field with the PRD-specified ceiling).
MAX_INPUT_CHARS=50000
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
# LLM inference request timeout (seconds). Used by services/localai.py.
LM_REQUEST_TIMEOUT_S=60
# URL fetch timeout (seconds). Deliberately separate from LM_REQUEST_TIMEOUT_S
# so a slow remote host cannot starve LLM inference callers. One total deadline
# covering DNS, connect, every redirect hop and the body. Finite, > 0, and
# not above LM_REQUEST_TIMEOUT_S (checked at startup).
LM_URL_FETCH_TIMEOUT_S=30

# User-URL fetch limits (SSRF guard for submitted URLs). Bad values stop the
# backend at startup instead of weakening the guard.
# Schemes a URL and every redirect hop may use: non-empty, lowercase, a subset
# of http,https.
URL_FETCH_ALLOWED_SCHEMES=http,https
# Redirect hops followed, each re-validated (0 refuses every redirect).
URL_FETCH_MAX_REDIRECTS=5
# Response body cap in bytes, enforced while streaming (>= 1).
URL_FETCH_MAX_BYTES=10485760
# CIDRs no fetch may reach (non-empty, comma-separated, valid networks). IPv4
# addresses embedded in IPv6 (mapped, compatible, 6to4, Teredo, NAT64) are
# checked too. Unset uses the built-in default in src/backend/app/config.py
# (loopback, RFC 1918, link-local and cloud metadata, CGNAT, 0.0.0.0/8,
# documentation, benchmarking, multicast, reserved, ::/96, ::1, ULA, IPv6
# link-local, site-local and multicast). Setting this REPLACES the default.
# URL_FETCH_BLOCKED_NETWORKS=

# CORS (comma-separated) — Streamlit UI on port 8501
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Watchlist background refresh in seconds (0 = disabled)
WATCHLIST_REFRESH_SECONDS=0
RRF_K=60
LEGAL_KB_TOP_K=5

# Language routing (EU languages route to EuroLLM; all others → Apertus)
LANGUAGE_DETECTION_ENABLED=true
# EU_LANGUAGE_CODES=bg,cs,da,de,el,en,es,et,fi,fr,ga,hr,hu,it,lt,lv,mt,nl,pl,pt,ro,sk,sl,sv

# Streamlit UI variant
STREAMLIT_UI=v2   # v2 (default): new plain-language design per issue #19. v1: legacy fallback.
