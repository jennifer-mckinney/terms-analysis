# LocalAI inference backend (Apache 2.0, zero VC — https://localai.io)
# Start LocalAI: docker run -p 8080:8080 localai/localai:latest
LOCALAI_BASE_URL=http://localhost:8080/v1

# Models (load in LocalAI before starting the backend)
# Apertus 8B Instruct — Swiss AI Initiative (EPFL/ETH Zurich/CSCS), Apache 2.0
# https://huggingface.co/swiss-ai/Apertus-8B-Instruct-2509-GGUF
MODEL_WORLD=apertus-8b-instruct

# EuroLLM 22B Instruct — EU Horizon Europe / EuroHPC, Apache 2.0, 35 EU languages
# https://huggingface.co/utter-project/EuroLLM-22B-Instruct-GGUF
MODEL_EU=eurollm-22b-instruct

# Database
DATABASE_URL=sqlite:///./data/terms_analysis.db

# API security (leave empty to disable auth for local dev)
# API_KEY=

# Analysis settings
REVIEW_THRESHOLD=0.80
MAX_INPUT_CHARS=20000
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
LM_REQUEST_TIMEOUT_S=60

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Watchlist background refresh in seconds (0 = disabled)
WATCHLIST_REFRESH_SECONDS=0
RRF_K=60
LEGAL_KB_TOP_K=5

# Language routing (EU languages route to EuroLLM; all others → Apertus)
LANGUAGE_DETECTION_ENABLED=true
# EU_LANGUAGE_CODES=bg,cs,da,de,el,en,es,et,fi,fr,ga,hr,hu,it,lt,lv,mt,nl,pl,pt,ro,sk,sl,sv
